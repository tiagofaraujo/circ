rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasVerifiedEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email != null;
    }

    function isAdmin() {
      return hasVerifiedEmail()
        && request.auth.token.email == 'circ.chuc@gmail.com';
    }

    function hasStoredRole(role) {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('roles', {}).get(role, false) == true;
    }

    function canManageSubmissions() {
      return isAdmin()
        || (
          hasVerifiedEmail()
          && request.auth.token.email in [
            'araujotiagofc@gmail.com',
            'acbdgomes@gmail.com',
            'afsilvacarvalho@gmail.com'
          ]
        )
        || hasStoredRole('submissions');
    }

    function canTestSubmissions() {
      return canManageSubmissions()
        && (
          isAdmin()
          || (
            hasVerifiedEmail()
            && request.auth.token.email in [
              'araujotiagofc@gmail.com',
              'acbdgomes@gmail.com',
              'afsilvacarvalho@gmail.com'
            ]
          )
          || hasStoredRole('submissionTesting')
        );
    }

    function canUseSecretariat() {
      return isAdmin()
        || hasStoredRole('secretariat')
        || (hasVerifiedEmail() && request.auth.token.email == 'tiago_araujo@hotmail.com');
    }

    function hasOwnAuditActor() {
      return request.resource.data.actor.uid == request.auth.uid
        && request.resource.data.actor.email == request.auth.token.email
        && request.resource.data.eventId == 'circ-2027';
    }

    function hasValidInitialSubmissionTimestamps() {
      return request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.status == 'draft'
            && request.resource.data.submittedAt == null
          )
          || (
            request.resource.data.status == 'submitted'
            && request.resource.data.submittedAt == request.time
          )
        );
    }

    function hasValidAbstractSections() {
      return request.resource.data.abstractSections is map
        && request.resource.data.abstractSections.keys().hasAll([
          'introduction',
          'objective',
          'methods',
          'results',
          'conclusion',
          'keywords'
        ])
        && request.resource.data.abstractSections.keys().hasOnly([
          'introduction',
          'objective',
          'methods',
          'results',
          'conclusion',
          'keywords'
        ])
        && request.resource.data.abstractSections.introduction is string
        && request.resource.data.abstractSections.objective is string
        && request.resource.data.abstractSections.methods is string
        && request.resource.data.abstractSections.results is string
        && request.resource.data.abstractSections.conclusion is string
        && request.resource.data.abstractSections.keywords is string
        && request.resource.data.abstractSections.introduction.size() <= 2500
        && request.resource.data.abstractSections.objective.size() <= 1500
        && request.resource.data.abstractSections.methods.size() <= 3000
        && request.resource.data.abstractSections.results.size() <= 3000
        && request.resource.data.abstractSections.conclusion.size() <= 2000
        && request.resource.data.abstractSections.keywords.size() <= 500
        && request.resource.data.abstract is string
        && request.resource.data.abstract.size() <= 15000
        && (
          request.resource.data.status == 'draft'
          || (
            request.resource.data.abstractSections.introduction.size() > 0
            && request.resource.data.abstractSections.objective.size() > 0
            && request.resource.data.abstractSections.methods.size() > 0
            && request.resource.data.abstractSections.results.size() > 0
            && request.resource.data.abstractSections.conclusion.size() > 0
            && request.resource.data.abstractSections.keywords.size() > 0
          )
        );
    }

    function isValidAuthorSubmissionUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'type',
          'title',
          'authors',
          'affiliation',
          'abstract',
          'abstractSections',
          'status',
          'updatedAt',
          'submittedAt'
        ])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && hasValidAbstractSections()
        && (
          (
            request.resource.data.status == 'draft'
            && request.resource.data.submittedAt == resource.data.submittedAt
          )
          || (
            request.resource.data.status == 'submitted'
            && request.resource.data.submittedAt == request.time
          )
        );
    }

    function validUlsNameKey(nameKey) {
      return nameKey is string
        && nameKey.size() >= 5
        && nameKey.size() <= 160;
    }

    // Recompute the key from the stored profile name inside the trusted rules.
    // Portuguese accents, combining marks, case, punctuation and particles do
    // not change a match. Never trust a client-supplied ulsNameKey on its own.
    function normalizedUlsName(name) {
      return name.upper()
        .replace('[ÀÁÂÃÄÅàáâãäå]', 'A')
        .replace('[ÈÉÊËèéêë]', 'E')
        .replace('[ÌÍÎÏìíîï]', 'I')
        .replace('[ÒÓÔÕÖòóôõö]', 'O')
        .replace('[ÙÚÛÜùúûü]', 'U')
        .replace('[Çç]', 'C')
        .replace('[Ññ]', 'N')
        .replace('[ÝŸýÿ]', 'Y')
        .replace('[\\x{0300}-\\x{036f}]', '')
        .replace('[^A-Z ]', ' ')
        .replace('\\b(D|DA|DAS|DE|DO|DOS)\\b', ' ')
        .replace(' +', ' ')
        .trim();
    }

    function hasPendingUlsMatch(userId, mec, nameKey) {
      let profile = getAfter(/databases/$(database)/documents/users/$(userId)).data;
      let roster = get(/databases/$(database)/documents/ulsRoster/$(mec)).data;
      return profile.get('name', '') is string
        && profile.get('name', '').size() >= 5
        && profile.get('name', '').size() <= 200
        && profile.get('ulsNameKey', '') == nameKey
        && normalizedUlsName(profile.get('name', '')) == nameKey
        && roster.get('active', false) == true
        && roster.get('eventId', '') == 'circ-2027'
        && roster.get('nameKey', '') == nameKey;
    }

    function validPendingUlsProfileMatch(userId) {
      let pendingEligibility =
        getAfter(/databases/$(database)/documents/ulsEligibility/$(userId)).data;
      let mec = pendingEligibility.get('mec', '');
      let nameKey = pendingEligibility.get('nameKey', '');
      return pendingEligibility.get('userId', '') == userId
        && pendingEligibility.get('eventId', '') == 'circ-2027'
        && pendingEligibility.get('status', '') == 'matched'
        && pendingEligibility.get('method', '') == 'mec-name-match'
        && validUlsNameKey(nameKey)
        && hasPendingUlsMatch(userId, mec, nameKey);
    }

    function validUlsProfileUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let eligibilityExists =
        exists(/databases/$(database)/documents/ulsEligibility/$(userId));
      return (
          !changed.hasAny(['ulsNameKey'])
          || (!eligibilityExists && validPendingUlsProfileMatch(userId))
        )
        && (
          !eligibilityExists
          || !changed.hasAny(['name', 'ulsNameKey'])
        );
    }

    function validMatchedEligibility(userId) {
      let eligibility = request.resource.data;
      let mec = eligibility.get('mec', '');
      let nameKey = eligibility.get('nameKey', '');
      let claimId = 'circ-2027_' + mec;
      let claim = getAfter(/databases/$(database)/documents/ulsMecClaims/$(claimId)).data;
      return hasVerifiedEmail()
        && request.auth.uid == userId
        && eligibility.keys().hasOnly([
          'userId',
          'eventId',
          'mec',
          'nameKey',
          'method',
          'status',
          'matchedAt'
        ])
        && eligibility.get('userId', '') == userId
        && eligibility.get('eventId', '') == 'circ-2027'
        && eligibility.get('method', '') == 'mec-name-match'
        && eligibility.get('status', '') == 'matched'
        && eligibility.get('matchedAt', null) == request.time
        && mec is string
        && mec.matches('^[0-9]{1,12}$')
        && validUlsNameKey(nameKey)
        && hasPendingUlsMatch(userId, mec, nameKey)
        && claim.get('userId', '') == userId
        && claim.get('eventId', '') == 'circ-2027'
        && claim.get('mec', '') == mec
        && claim.get('nameKey', '') == nameKey
        && claim.get('method', '') == 'mec-name-match';
    }

    function validUlsClaim(claimId) {
      let claim = request.resource.data;
      let userId = claim.get('userId', '');
      let mec = claim.get('mec', '');
      let nameKey = claim.get('nameKey', '');
      let eligibility = getAfter(/databases/$(database)/documents/ulsEligibility/$(userId)).data;
      return hasVerifiedEmail()
        && request.auth.uid == userId
        && claimId == 'circ-2027_' + mec
        && claim.keys().hasOnly([
          'userId',
          'eventId',
          'mec',
          'nameKey',
          'method',
          'claimedAt'
        ])
        && claim.get('eventId', '') == 'circ-2027'
        && claim.get('method', '') == 'mec-name-match'
        && claim.get('claimedAt', null) == request.time
        && mec is string
        && mec.matches('^[0-9]{1,12}$')
        && validUlsNameKey(nameKey)
        && hasPendingUlsMatch(userId, mec, nameKey)
        && eligibility.get('userId', '') == userId
        && eligibility.get('eventId', '') == 'circ-2027'
        && eligibility.get('mec', '') == mec
        && eligibility.get('nameKey', '') == nameKey
        && eligibility.get('method', '') == 'mec-name-match'
        && eligibility.get('status', '') == 'matched';
    }

    // Eligibility and MEC claims are immutable proof that the exact profile/roster
    // match succeeded. They survive personal-profile deletion, while the roster
    // remains the authoritative switch for accepting ULS registrations.
    function hasMatchedUlsEligibility(userId) {
      let eligibility = get(/databases/$(database)/documents/ulsEligibility/$(userId)).data;
      let mec = eligibility.get('mec', '');
      let nameKey = eligibility.get('nameKey', '');
      let claimId = 'circ-2027_' + mec;
      let claim = get(/databases/$(database)/documents/ulsMecClaims/$(claimId)).data;
      let roster = get(/databases/$(database)/documents/ulsRoster/$(mec)).data;
      return eligibility.get('eventId', '') == 'circ-2027'
        && eligibility.get('userId', '') == userId
        && eligibility.get('status', '') == 'matched'
        && eligibility.get('method', '') == 'mec-name-match'
        && validUlsNameKey(nameKey)
        && claim.get('userId', '') == userId
        && claim.get('eventId', '') == 'circ-2027'
        && claim.get('mec', '') == mec
        && claim.get('nameKey', '') == nameKey
        && claim.get('method', '') == 'mec-name-match'
        && roster.get('active', false) == true
        && roster.get('eventId', '') == 'circ-2027'
        && roster.get('nameKey', '') == nameKey;
    }

    function canReadOwnUlsRoster(mec) {
      return signedIn()
        && get(/databases/$(database)/documents/ulsEligibility/$(request.auth.uid))
          .data.get('userId', '') == request.auth.uid
        && get(/databases/$(database)/documents/ulsEligibility/$(request.auth.uid))
          .data.get('eventId', '') == 'circ-2027'
        && get(/databases/$(database)/documents/ulsEligibility/$(request.auth.uid))
          .data.get('status', '') == 'matched'
        && get(/databases/$(database)/documents/ulsEligibility/$(request.auth.uid))
          .data.get('method', '') == 'mec-name-match'
        && get(/databases/$(database)/documents/ulsEligibility/$(request.auth.uid))
          .data.get('mec', '') == mec;
    }

    function hasValidUlsRegistration(data) {
      let selection = data.get('selection', {});
      return data.get('isTest', false) == true
        || (selection.get('profile', '') != 'uls' && selection.get('courseAffiliation', '') != 'uls')
        || hasMatchedUlsEligibility(data.userId);
    }

    function validAdminHistoricalRegistrationUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let paymentChanged = changed.hasAny(['payment']);
      return changed.hasOnly(['status', 'payment', 'updatedAt', 'updatedBy'])
        && changed.hasAny(['status', 'payment'])
        && request.resource.data.updatedAt == request.time
        && (
          !changed.hasAny(['status'])
          || (
            request.resource.data.status in ['draft', 'submitted', 'confirmed', 'cancelled']
            && request.resource.data.updatedBy.uid == request.auth.uid
            && request.resource.data.updatedBy.email == request.auth.token.email
          )
        )
        && (
          !paymentChanged
          || (
            request.resource.data.payment.diff(resource.data.payment).affectedKeys()
              .hasOnly(['status', 'updatedAt', 'updatedBy'])
            && request.resource.data.payment.status in [
              'pending',
              'awaiting_confirmation',
              'paid',
              'refunded',
              'cancelled'
            ]
            && request.resource.data.payment.updatedAt == request.time
            && request.resource.data.payment.updatedBy.uid == request.auth.uid
            && request.resource.data.payment.updatedBy.email == request.auth.token.email
          )
        );
    }

    function hasValidUlsOrder(data) {
      let registration = get(/databases/$(database)/documents/registrations/$(data.registrationId)).data;
      return data.get('isTest', false) == true
        || (registration.userId == data.userId && hasValidUlsRegistration(registration));
    }

    // The roster stays private. A verified user may only create an atomic MEC/name match
    // with the deterministic, single-use claim document required by the rules.
    match /ulsEligibility/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if validMatchedEligibility(userId);
      allow update, delete: if false;
    }
    match /ulsRoster/{mec} {
      // A matched participant may observe only their own claimed entry so that
      // deactivation is reflected immediately. Collection listing stays private.
      allow get: if canReadOwnUlsRoster(mec);
      allow list, write: if false;
    }
    match /ulsMecClaims/{claimId} {
      allow create: if validUlsClaim(claimId);
      allow read, update, delete: if false;
    }
    match /ulsChallenges/{userId} { allow read, write: if false; }
    match /ulsRateLimits/{limitId} { allow read, write: if false; }

    // Student eligibility is a staff decision about a specific profile name and
    // document revision. Proofs are private, bounded and never queried in bulk.
    function studentProfileMatches(userId, data) {
      return data.profileName is string
        && data.profileName.trim().size() >= 5 && data.profileName.size() <= 200
        && data.profileName == getAfter(/databases/$(database)/documents/users/$(userId)).data.name;
    }

    function validStudentRequest(userId) {
      let data = request.resource.data;
      let proof = getAfter(/databases/$(database)/documents/studentProofs/$(userId)).data;
      return isOwner(userId) && hasVerifiedEmail()
        && data.keys().hasOnly([
          'userId', 'eventId', 'email', 'profileName', 'school', 'course', 'academicYear',
          'status', 'revision', 'proofAvailable', 'submittedAt', 'updatedAt',
          'reviewedAt', 'reviewedBy', 'reviewNote'
        ])
        && data.userId == userId && data.eventId == 'circ-2027'
        && data.email == request.auth.token.email && data.academicYear == '2026/2027'
        && studentProfileMatches(userId, data)
        && data.school is string && data.school.trim().size() >= 2 && data.school.size() <= 160
        && data.course is string && data.course.trim().size() >= 2 && data.course.size() <= 160
        && data.status == 'pending' && data.proofAvailable == true
        && data.revision is int && data.revision > 0
        && data.submittedAt == request.time && data.updatedAt == request.time
        && data.reviewedAt == null && data.reviewedBy == null && data.reviewNote == ''
        && proof.userId == userId && proof.eventId == data.eventId
        && proof.revision == data.revision && proof.updatedAt == request.time;
    }

    function validStudentProof(userId) {
      let data = request.resource.data;
      let application = getAfter(/databases/$(database)/documents/studentVerifications/$(userId)).data;
      let previousRevision = exists(/databases/$(database)/documents/studentVerifications/$(userId))
        ? get(/databases/$(database)/documents/studentVerifications/$(userId)).data.revision : 0;
      return isOwner(userId) && hasVerifiedEmail()
        && data.keys().hasOnly(['userId', 'eventId', 'revision', 'mimeType', 'base64', 'updatedAt'])
        && data.userId == userId && data.eventId == 'circ-2027' && data.updatedAt == request.time
        && data.base64 is string && data.base64.size() >= 8 && data.base64.size() <= 409600
        && data.base64.size() % 4 == 0 && data.base64.matches('^[A-Za-z0-9+/]+={0,2}$')
        && ((data.mimeType == 'image/jpeg' && data.base64.matches('^/9j/.*'))
          || (data.mimeType == 'application/pdf' && data.base64.matches('^JVBERi0.*')))
        && application.userId == userId && application.eventId == data.eventId
        && application.status == 'pending' && application.proofAvailable == true
        && application.submittedAt == request.time
        && application.revision == data.revision && data.revision == previousRevision + 1;
    }

    function validStudentReview(userId) {
      let data = request.resource.data;
      return canUseSecretariat() && request.auth.uid != userId
        && data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedAt', 'updatedAt'])
        && data.status in ['approved', 'correction', 'rejected']
        && data.reviewNote is string && data.reviewNote.size() <= 1000
        && (data.status == 'approved' || data.reviewNote.trim().size() >= 5)
        && data.reviewedBy.keys().hasOnly(['uid', 'email'])
        && data.reviewedBy.uid == request.auth.uid && data.reviewedBy.email == request.auth.token.email
        && data.reviewedAt == request.time && data.updatedAt == request.time
        && (data.status != 'approved' || (
          data.proofAvailable == true && studentProfileMatches(userId, data)
          && getAfter(/databases/$(database)/documents/studentProofs/$(userId)).data.revision == data.revision
        ));
    }

    function validStudentProofRemoval(userId) {
      return canUseSecretariat() && resource.data.status != 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proofAvailable', 'updatedAt'])
        && request.resource.data.proofAvailable == false && request.resource.data.updatedAt == request.time
        && !existsAfter(/databases/$(database)/documents/studentProofs/$(userId));
    }

    function hasApprovedStudent(userId) {
      let data = get(/databases/$(database)/documents/studentVerifications/$(userId)).data;
      return data.userId == userId && data.eventId == 'circ-2027'
        && data.academicYear == '2026/2027' && data.status == 'approved'
        && studentProfileMatches(userId, data);
    }

    function hasValidStudentRegistration(data) {
      return data.get('isTest', false) == true
        || data.get('selection', {}).get('profile', '') != 'student'
        || (data.eventId == 'circ-2027' && hasApprovedStudent(data.userId));
    }

    function canUpdateStudentRegistration(data) {
      // Revocation must not prevent cancellation/refund of an earlier registration,
      // but historical-update permissions must not bypass student approval.
      let changed = data.diff(resource.data).affectedKeys();
      return hasValidStudentRegistration(data) || (
        validAdminHistoricalRegistrationUpdate()
        && (!changed.hasAny(['status']) || data.status == 'cancelled')
        && (!changed.hasAny(['payment']) || data.payment.status in ['cancelled', 'refunded'])
      );
    }

    function hasValidStudentOrder(data) {
      let registration = get(/databases/$(database)/documents/registrations/$(data.registrationId)).data;
      return data.get('isTest', false) == true || (
        registration.userId == data.userId && hasValidStudentRegistration(registration)
      );
    }

    match /studentVerifications/{userId} {
      allow get: if isOwner(userId) || canUseSecretariat();
      allow list: if canUseSecretariat() && request.query.limit <= 25;
      allow create: if validStudentRequest(userId) && request.resource.data.revision == 1;
      allow update: if (validStudentRequest(userId)
          && request.resource.data.revision == resource.data.revision + 1
          && request.time >= resource.data.submittedAt + duration.value(60, 's'))
        || validStudentReview(userId) || validStudentProofRemoval(userId);
      allow delete: if isOwner(userId)
        && !existsAfter(/databases/$(database)/documents/studentProofs/$(userId));
    }

    match /studentProofs/{userId} {
      allow get: if isOwner(userId) || canUseSecretariat();
      allow list: if false;
      allow create, update: if validStudentProof(userId);
      allow delete: if (isOwner(userId)
          && !existsAfter(/databases/$(database)/documents/studentVerifications/$(userId)))
        || (canUseSecretariat()
          && getAfter(/databases/$(database)/documents/studentVerifications/$(userId)).data.status != 'pending'
          && getAfter(/databases/$(database)/documents/studentVerifications/$(userId)).data.proofAvailable == false);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.keys().hasAny(['roles', 'ulsNameKey'])
        && !exists(/databases/$(database)/documents/ulsEligibility/$(userId))
      );
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles'])
        && validUlsProfileUpdate(userId)
      );
      // Deleting a My CIRC account must remove its personal profile even
      // after a ULS match. The private eligibility and MEC reservation remain.
      allow delete: if isAdmin() || isOwner(userId);
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Company purchases are private to the registrations administrator.
    function validCompanyPurchase(d) {
      return d.keys().hasOnly(['eventId', 'company', 'quantity', 'unitAmountCents', 'amountCents', 'status', 'codes',
          'transferReference', 'fiscalReference', 'createdAt', 'updatedAt', 'createdBy', 'confirmedBy', 'confirmedAt'])
        && d.eventId == 'circ-2027'
        && d.company.keys().hasOnly(['name', 'taxNumber', 'address', 'email'])
        && d.company.name is string && d.company.name.size() >= 2 && d.company.name.size() <= 160
        && d.company.taxNumber is string && d.company.taxNumber.size() > 0 && d.company.taxNumber.size() <= 40
        && d.company.address is string && d.company.address.size() > 0 && d.company.address.size() <= 300
        && d.company.email is string && d.company.email.size() > 3 && d.company.email.size() <= 254
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 50
        && d.unitAmountCents is int && d.unitAmountCents > 0 && d.unitAmountCents <= 100000
        && d.amountCents == d.quantity * d.unitAmountCents;
    }
    match /companyPurchases/{purchaseId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validCompanyPurchase(request.resource.data)
        && request.resource.data.status == 'pending' && request.resource.data.codes == []
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.confirmedAt == null && request.resource.data.confirmedBy == null
        && request.resource.data.transferReference == '' && request.resource.data.fiscalReference == '';
      allow update: if isAdmin() && resource.data.status == 'pending'
        && request.resource.data.status == 'paid'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'codes', 'transferReference', 'fiscalReference', 'confirmedAt', 'confirmedBy', 'updatedAt'])
        && request.resource.data.codes is list && request.resource.data.codes.size() == resource.data.quantity
        && request.resource.data.codes.toSet().size() == resource.data.quantity
        && request.resource.data.transferReference is string && request.resource.data.transferReference.size() >= 2 && request.resource.data.transferReference.size() <= 200
        && request.resource.data.fiscalReference is string && request.resource.data.fiscalReference.size() <= 200
        && request.resource.data.confirmedBy == request.auth.uid && request.resource.data.confirmedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
    function companyCodesEnabled() {
      return get(/databases/$(database)/documents/settings/circ-2027-company-vouchers).data.enabled == true;
    }
    function validCompanyVoucherCreate(code) {
      let d = request.resource.data;
      let p = getAfter(/databases/$(database)/documents/companyPurchases/$(d.purchaseId)).data;
      return code.matches('^[a-f0-9]{32}$')
        && d.keys().hasOnly(['eventId', 'purchaseId', 'index', 'companyName', 'unitAmountCents', 'status', 'redeemedBy', 'registrationId', 'redeemedAt', 'createdAt', 'updatedAt'])
        && d.eventId == 'circ-2027' && p.status == 'paid'
        && d.index is int && d.index >= 0 && d.index < p.quantity && p.codes[d.index] == code
        && d.companyName == p.company.name && d.unitAmountCents == p.unitAmountCents
        && d.status == 'available' && d.redeemedBy == null && d.registrationId == null && d.redeemedAt == null
        && d.createdAt == request.time && d.updatedAt == request.time;
    }
    function validCompanyRedemption(code) {
      let d = request.resource.data;
      let regId = 'circ-2027-' + request.auth.uid;
      return hasVerifiedEmail() && companyCodesEnabled()
        && resource.data.status == 'available'
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'redeemedBy', 'registrationId', 'redeemedAt', 'updatedAt'])
        && d.status == 'redeemed' && d.redeemedBy == request.auth.uid && d.registrationId == regId
        && d.redeemedAt == request.time && d.updatedAt == request.time
        && !exists(/databases/$(database)/documents/registrations/$(regId))
        && getAfter(/databases/$(database)/documents/registrations/$(regId)).data.voucherId == code;
    }
    match /companyVouchers/{code} {
      // 128-bit random bearer code; no enumeration and no company billing data.
      allow get: if isAdmin() || (hasVerifiedEmail() && companyCodesEnabled()
        && (!exists(/databases/$(database)/documents/companyVouchers/$(code))
          || resource.data.status == 'available' || resource.data.redeemedBy == request.auth.uid));
      allow list: if isAdmin();
      allow create: if isAdmin() && validCompanyVoucherCreate(code);
      allow update: if (isAdmin() && resource.data.status == 'available' && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time) || validCompanyRedemption(code);
    }
    function validCompanyRegistration(regId) {
      let d = request.resource.data;
      let v = get(/databases/$(database)/documents/companyVouchers/$(d.voucherId)).data;
      let used = getAfter(/databases/$(database)/documents/companyVouchers/$(d.voucherId)).data;
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return hasVerifiedEmail() && companyCodesEnabled() && regId == 'circ-2027-' + request.auth.uid
        && d.keys().hasOnly(['eventId', 'userId', 'registrationKey', 'primaryRegistration', 'participantName', 'participantEmail',
          'registrationType', 'status', 'isTest', 'testMode', 'selection', 'entitlements', 'payment', 'voucherId',
          'companyPurchaseId', 'addOnOrderCount', 'documentCount', 'createdAt', 'updatedAt'])
        && d.eventId == 'circ-2027' && d.userId == request.auth.uid
        && d.registrationKey == 'circ-2027:' + request.auth.uid && d.primaryRegistration == true
        && d.participantName == profile.name && d.participantName is string && d.participantName.trim().size() >= 5 && d.participantName.size() <= 200
        && d.participantEmail == request.auth.token.email && d.registrationType == 'CIRC 2027 · Presencial'
        && d.status == 'confirmed' && d.isTest == false && d.testMode == false
        && d.selection == {'profile': 'external', 'courseAffiliation': 'external', 'congressMode': 'onsite', 'morningCourse': false,
          'afternoonCourse': false, 'dinner': false, 'dinnerQuantity': 0, 'ratePeriod': 'company'}
        && d.entitlements == {'congressMode': 'onsite', 'morningCourse': false, 'afternoonCourse': false, 'dinnerQuantity': 0}
        && d.payment == {'status': 'paid', 'amountCents': 0, 'coveredAmountCents': v.unitAmountCents, 'currency': 'EUR',
          'method': 'company_voucher', 'reference': v.purchaseId, 'payer': v.companyName}
        && d.companyPurchaseId == v.purchaseId && d.addOnOrderCount == 0 && d.documentCount == 0
        && d.createdAt == request.time && d.updatedAt == request.time
        && v.eventId == 'circ-2027' && v.status == 'available' && used.status == 'redeemed'
        && used.redeemedBy == request.auth.uid && used.registrationId == regId && used.redeemedAt == request.time;
    }
    match /settings/circ-2027-company-vouchers {
      allow get: if hasVerifiedEmail();
    }

    match /registrations/{registrationId} {
      allow get: if hasVerifiedEmail() && registrationId == "circ-2027-" + request.auth.uid;
      allow create: if validCompanyRegistration(registrationId);
      allow read: if isAdmin()
        || canUseSecretariat()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() && hasValidUlsRegistration(request.resource.data)
        && hasValidStudentRegistration(request.resource.data);
      allow delete: if isAdmin();
      allow update: if (
        isAdmin()
        && canUpdateStudentRegistration(request.resource.data)
        && (
          hasValidUlsRegistration(request.resource.data)
          || validAdminHistoricalRegistrationUpdate()
        )
      ) || (
        canUseSecretariat()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['attendance', 'credential', 'updatedAt'])
      );
    }

    match /registrationOrders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin() && hasValidUlsOrder(request.resource.data)
        && hasValidStudentOrder(request.resource.data);
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /documents/{documentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isAdmin()
        || (
          canManageSubmissions()
          && resource.data.status != 'draft'
        )
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (
          canTestSubmissions()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.eventId == 'circ-2027'
          && request.resource.data.get('isTest', false) == true
          && request.resource.data.status in ['draft', 'submitted']
          && hasValidAbstractSections()
          && hasValidInitialSubmissionTimestamps()
        )
        || (
          signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.eventId == 'circ-2027'
          && request.resource.data.get('isTest', false) == false
          && request.resource.data.status in ['draft', 'submitted']
          && hasValidAbstractSections()
          && hasValidInitialSubmissionTimestamps()
        );
      allow update: if isAdmin()
        || (
          canManageSubmissions()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'review', 'updatedAt'])
          && request.resource.data.status in [
            'submitted',
            'under_review',
            'revisions',
            'accepted',
            'rejected'
          ]
          && request.resource.data.review.note is string
          && request.resource.data.review.note.size() <= 1000
          && request.resource.data.review.updatedBy.uid == request.auth.uid
          && request.resource.data.review.updatedBy.email == request.auth.token.email
        )
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && resource.data.status == 'draft'
          && request.resource.data.status in ['draft', 'submitted']
          && isValidAuthorSubmissionUpdate()
        );
      allow delete: if isAdmin()
        || (
          canTestSubmissions()
          && resource.data.userId == request.auth.uid
          && resource.data.get('isTest', false) == true
        )
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.get('isTest', false) == false
          && resource.data.status == 'draft'
        );
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        || (
          canManageSubmissions()
          && hasOwnAuditActor()
          && request.resource.data.submissionId is string
          && request.resource.data.action == 'submission.review.updated'
        )
        || (
          canTestSubmissions()
          && hasOwnAuditActor()
          && request.resource.data.submissionId is string
          && request.resource.data.action in [
            'submission.test.created',
            'submission.test.deleted'
          ]
        )
        || (
          canUseSecretariat()
          && hasOwnAuditActor()
          && request.resource.data.registrationId is string
          && request.resource.data.action in [
            'attendance.checkin.completed',
            'attendance.checkin.reverted',
            'credential.delivered',
            'credential.delivery.reverted'
          ]
        );
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
