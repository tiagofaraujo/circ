# Firebase Web App configuration for CIRC Authentication + Firestore
# Copy these values from Firebase Console > Project settings > Your apps > Web app.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Verified email allowed to access /admin. Keep this value aligned with
# firestore.rules and storage.rules.
REACT_APP_ADMIN_EMAIL=circ.chuc@gmail.com

# Enable only after Microsoft provider is configured in Firebase Authentication.
REACT_APP_MICROSOFT_AUTH_ENABLED=false

# Enable only after deploying the ULS functions/rules and privately importing the roster.
REACT_APP_ULS_VERIFICATION_ENABLED=false
REACT_APP_ULS_FUNCTIONS_REGION=europe-west1

