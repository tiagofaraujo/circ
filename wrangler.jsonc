{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "circ",
  "compatibility_date": "2026-07-05",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media",
      "/media/",
      "/press",
      "/press/",
      "/media-files/*",
      "/media-assets/*",
      "/media-access",
      "/programa",
      "/programa/"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "server/worker.mjs",
  "vars": {
    "FIREBASE_PROJECT_ID": "circ-coimbra",
    "EUPAGO_LIVE_CHANNEL": "CIRC 2027",
    "EUPAGO_SANDBOX_CHANNEL": "demo-Hemisfério Disciplinado Lda",
    "LIVE_CHECKOUT_ENABLED": "true",
    "LIVE_PILOT_UNTIL": "2026-10-31T11:22:19Z",
    "TOCONLINE_REDIRECT_URL": "https://circ-coimbra.org/api/fiscal/toconline/callback"
  }
}
