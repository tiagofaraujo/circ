{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "circ",
  "compatibility_date": "2026-07-05",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "server/worker.mjs",
  "vars": {
    "FIREBASE_PROJECT_ID": "circ-coimbra"
  }
}
