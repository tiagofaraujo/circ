{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "uls-verification",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "scripts",
        ".env*",
        ".secret*",
        "private-data",
        "*-debug.log"
      ]
    }
  ]
}
